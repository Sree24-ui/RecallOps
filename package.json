{
  "name": "recallops",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.dev.vars node_modules/vite/bin/vite.js",
    "build": "vite build",
    "postbuild": "node scripts/clean-build-secrets.mjs",
    "start": "node --env-file-if-exists=.dev.vars .output/server/index.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "db:migrate": "node --env-file-if-exists=.dev.vars scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "test:e2e": "playwright test",
    "test:live": "node --import tsx --test tests/live.test.ts",
    "catalog:refresh": "node scripts/refresh-catalog.mjs",
    "build:vercel": "NITRO_PRESET=vercel npm run build",
    "test:libsql": "TEST_DATABASE_DRIVER=libsql npm test"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@libsql/client": "0.18.0",
    "@shadcn/react": "0.3.0",
    "@vercel/functions": "3.9.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  },
  "type": "module",
  "overrides": {
    "sharp": "0.35.4",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
