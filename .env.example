# Copy to .dev.vars for local Cloudflare/Vinext development. Never commit .dev.vars.
ANAKIN_API_KEY=
# Optional public HTTPS origin for live monitor webhooks. Requires real deployment.
PUBLIC_BASE_URL=
# Required on non-local deployments: server-side bearer token for operator API access.
OPERATOR_TOKEN=

# Tests only: leave false for the normal workspace and every deployed instance.
ENABLE_TEST_FIXTURES=false
