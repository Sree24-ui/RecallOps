# Copy to .dev.vars for local Node/Vinext development. Never commit .dev.vars.
ANAKIN_API_KEY=
# Optional public HTTPS origin for live monitor webhooks. Requires real deployment.
PUBLIC_BASE_URL=
# Required remotely: private owner sign-in key/session-signing secret; also accepts API bearer access.
OPERATOR_TOKEN=

# Local development defaults to file:.data/recallops.sqlite when this is empty.
# Vercel requires a persistent libsql:// Turso database and its server-only token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Tests only: leave false for the normal workspace. Always disabled on Vercel/Netlify.
ENABLE_TEST_FIXTURES=false
